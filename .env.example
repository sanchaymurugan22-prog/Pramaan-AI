# Copy this file to .env and fill in values. Never commit .env.
# Values only, no quotes. Keep comments on their own lines.
# Paths are relative to the project root.

# --- AI provider switch: local | cloud | mock ---
# mock = no model at all, instant answers built from the source by simple rules (for testing)
AI_MODE=local
# mock only: pretend each answer takes this many seconds (0 = instant)
MOCK_DELAY_SECONDS=0

# local: llama.cpp llama-server (OpenAI-compatible API)
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=sarvam-30b

# cloud: Sarvam AI hosted API (development fallback only)
# Docs: https://docs.sarvam.ai/api-reference/chat/chat-completions-v1
# Note: sarvam-30b is deprecated on the hosted API; sarvam-105b is the current chat model.
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b
# Only needed when AI_MODE=cloud
SARVAM_API_KEY=

# How long to wait for the LLM, in seconds. The local 30B model writes about 1.4 tokens/second
# on the dev Intel Mac, so keep this long. Local answers are streamed, so this is the longest
# wait for the NEXT word (including reading the prompt first), not for the whole answer.
LLM_TIMEOUT_SECONDS=600

# --- fact sheet ---
# Long sources are split into pieces of this many characters (fits the 4096-token context)
FACTSHEET_CHUNK_CHARS=6000
# How many key facts to ask for (8 at most). Fewer = faster on the slow laptop.
FACTSHEET_MAX_FACTS=8

# --- most tokens the AI may write per answer (at ~1.4 tokens/second, 350 = about 4 minutes) ---
# "Short" level of detail uses 75% of these, "Detailed" 130%.
MAX_TOKENS_FACTSHEET=1400
MAX_TOKENS_X_THREAD=350
MAX_TOKENS_LINKEDIN_POST=350
MAX_TOKENS_EXECUTIVE_SUMMARY=450
MAX_TOKENS_INFOGRAPHIC=400
MAX_TOKENS_ADVISORY=800
MAX_TOKENS_PRESENTATION=900
MAX_TOKENS_VIDEO_PACKAGE=900

# --- app ---
# Secret key for sign-in sessions. Leave it empty: a random one is made on first run and saved here
# in .env (it is never printed). Changing it signs everybody out.
APP_SECRET_KEY=
# Key that encrypts the database and stored files (64 hex characters). Leave it empty: a random one
# is made on first run and saved here. BACK IT UP with data/: without it the data cannot be read.
# Never change it on an existing install.
DB_KEY=
# Web pages allowed to send changes to the API (comma-separated). Normally leave as it is.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
DATA_DIR=./data
